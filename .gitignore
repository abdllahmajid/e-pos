# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── TAMBAHAN ── scripts/migrate.ts sempat berisi service_role key asli
# hardcoded (2 project Supabase) — key sudah WAJIB di-rotate dari Dashboard
# terlepas dari baris ini (.gitignore tidak menghapus riwayat commit lama).
# Kalau butuh script migrasi data lagi ke depan, baca URL/key dari env var
# (mis. process.env.OLD_SUPABASE_URL), JANGAN ditulis langsung di kode.
scripts/migrate.ts